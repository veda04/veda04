# CMS One API is a service that provides unified API for multiple CMS platforms. You can get your API key and URL from the CMS One dashboard.
# URL: https://cmsone.cosmokode.com/
CMS_ONE_API_KEY=your_cmsone_api_key
CMS_ONE_API_URL=your_cmsone_api_url

NEXT_PUBLIC_APP_URL=your_public_url

# NodeMailer SMTP Configurations.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Google reCAPTCHA Enterprise (bot protection on the contact form).
# The site key is public by design and exposed to the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# Google Cloud project that owns the reCAPTCHA key.
RECAPTCHA_PROJECT_ID=your_gcp_project_id
# Server-side verification authenticates via Application Default Credentials:
# point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key with the
# "reCAPTCHA Enterprise Agent" role, or run on GCP with a suitable identity.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
